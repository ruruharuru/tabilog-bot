# このファイルをコピーして「.env」という名前で保存し、実際の値を入力してください

# Discord Developer PortalのBotページで取得したトークン
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google CloudでダウンロードしたサービスアカウントのJSONファイルの中身を1行で貼り付け
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 記録用スプレッドシートのURLに含まれるID部分
GOOGLE_SHEET_ID=your_google_sheet_id_here
